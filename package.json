local function configureLighting(project)

    local lightingData =
        project.lighting
        or {}

    if lightingData.clockTime then

        local clock =
            tonumber(lightingData.clockTime)

        if clock then
            Lighting.ClockTime = clock
        end
    end

    if lightingData.brightness then

        local brightness =
            tonumber(lightingData.brightness)

        if brightness then
            Lighting.Brightness = brightness
        end
    end

    if lightingData.ambient then

        if typeof(lightingData.ambient) == "table" then

            local r =
                tonumber(lightingData.ambient.r or 100)
                or 100

            local g =
                tonumber(lightingData.ambient.g or 100)
                or 100

            local b =
                tonumber(lightingData.ambient.b or 100)
                or 100

            Lighting.Ambient =
                Color3.fromRGB(r, g, b)
        end
    end
end

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local function createConfig(aiFolder, project)

    local config = Instance.new("Configuration")

    config.Name = "GameConfig"

    config:SetAttribute(
        "GameName",
        tostring(
            project.title
            or project.name
            or "Roblox AI Game"
        )
    )

    config:SetAttribute(
        "Genre",
        tostring(
            project.genre
            or project.genero
            or "Adventure"
        )
    )

    config:SetAttribute(
        "Players",
        tonumber(
            project.players
            or project.maxPlayers
            or 12
        )
        or 12
    )

    config:SetAttribute(
        "GeneratedBy",
        "Roblox AI Studio"
    )

    config.Parent = aiFolder

    return config
end

--------------------------------------------------
-- BUILD
--------------------------------------------------

local function buildProject(project)

    ChangeHistoryService:SetWaypoint(
        "Roblox AI Builder - Antes"
    )

    --------------------------------------------------
    -- CLEAR OLD
    --------------------------------------------------

    clearGenerated()

    --------------------------------------------------
    -- WORKSPACE
    --------------------------------------------------

    local generatedMap =
        createFolder(
            workspace,
            "GeneratedMap"
        )

    generatedMap:SetAttribute(
        "GeneratedBy",
        "RobloxAIBuilder"
    )

    --------------------------------------------------
    -- MAP
    --------------------------------------------------

    createAreas(
        generatedMap,
        project
    )

    createObjects(
        generatedMap,
        project
    )

    createNPCs(
        generatedMap,
        project
    )

    createSpawns(
        generatedMap,
        project
    )

    --------------------------------------------------
    -- REPLICATED STORAGE
    --------------------------------------------------

    local replicated =
        game:GetService("ReplicatedStorage")

    local aiFolder =
        createFolder(
            replicated,
            "RobloxAI"
        )

    aiFolder:SetAttribute(
        "GeneratedBy",
        "RobloxAIBuilder"
    )

    createRemotes(
        aiFolder,
        project
    )

    createModules(
        aiFolder
    )

    createConfig(
        aiFolder,
        project
    )

    --------------------------------------------------
    -- SERVER
    --------------------------------------------------

    local server =
        game:GetService("ServerScriptService")

    local serverAI =
        createFolder(
            server,
            "RobloxAI"
        )

    serverAI:SetAttribute(
        "GeneratedBy",
        "RobloxAIBuilder"
    )

    createSystems(
        serverAI
    )

    createGeneratedScripts(
        serverAI,
        project
    )

    --------------------------------------------------
    -- LIGHTING
    --------------------------------------------------

    configureLighting(
        project
    )

    --------------------------------------------------
    -- SELECT MAP
    --------------------------------------------------

    Selection:Set({
        generatedMap
    })

    --------------------------------------------------
    -- FINISH
    --------------------------------------------------

    ChangeHistoryService:SetWaypoint(
        "Roblox AI Builder - Depois"
    )

    return true
end

--------------------------------------------------
-- JSON IMPORT
--------------------------------------------------

local function importJSON()

    local text = jsonBox.Text

    if not text or text == "" then

        setStatus(
            "❌ Cole o JSON do projeto primeiro.",
            Color3.fromRGB(255, 100, 100)
        )

        return
    end

    setStatus(
        "⏳ Lendo projeto...",
        Color3.fromRGB(255, 220, 100)
    )

    local success, project =
        pcall(function()

            return HttpService:JSONDecode(text)

        end)

    if not success then

        setStatus(
            "❌ JSON inválido.",
            Color3.fromRGB(255, 100, 100)
        )

        warn(
            "[Roblox AI Builder] Erro JSON:",
            project
        )

        return
    end

    if typeof(project) ~= "table" then

        setStatus(
            "❌ O projeto precisa ser um objeto JSON.",
            Color3.fromRGB(255, 100, 100)
        )

        return
    end

    setStatus(
        "🔨 Montando jogo...",
        Color3.fromRGB(100, 200, 255)
    )

    local built, errorMessage =
        pcall(function()

            buildProject(project)

        end)

    if not built then

        setStatus(
            "❌ Erro durante a montagem.",
            Color3.fromRGB(255, 100, 100)
        )

        warn(
            "[Roblox AI Builder] Build Error:",
            errorMessage
        )

        return
    end

    local gameName =
        project.title
        or project.name
        or "Roblox AI Game"

    setStatus(
        "✅ Jogo montado: " .. tostring(gameName),
        Color3.fromRGB(100, 255, 150)
    )

    print(
        "===================================="
    )

    print(
        "[Roblox AI Builder] JOGO MONTADO"
    )

    print(
        "Nome:",
        gameName
    )

    print(
        "===================================="
    )
end

