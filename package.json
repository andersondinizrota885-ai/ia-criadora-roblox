local function createLocalScript(parent, name, source)
    local localScript = Instance.new("LocalScript")

    localScript.Name = safeName(name, "LocalScript")

    localScript.Source = source or [[
print("[Roblox AI] LocalScript iniciado:", script.Name)
]]

    localScript.Parent = parent

    return localScript
end

