--------------------------------------------------
-- UTILS
--------------------------------------------------

local function setStatus(text, color)
    status.Text = text
    status.TextColor3 = color or Color3.fromRGB(255, 255, 255)
end

local function safeName(name, fallback)
    if typeof(name) ~= "string" or name == "" then
        return fallback
    end

    return name:gsub("[^%w%s_%-]", "")
end

local function createFolder(parent, name)
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent
    return folder
end

local function createPart(parent, name, position, size)
    local part = Instance.new("Part")

    part.Name = safeName(name, "Object")
    part.Size = size or Vector3.new(8, 4, 8)
    part.Position = position or Vector3.new(0, 2, 0)

    part.Anchored = true
    part.CanCollide = true

    part.Parent = parent

    return part
end

--------------------------------------------------
-- ROOT
--------------------------------------------------

local function getOrCreateFolder(parent, name)
    local existing = parent:FindFirstChild(name)

    if existing and existing:IsA("Folder") then
        return existing
    end

    if existing then
        existing:Destroy()
    end

    return createFolder(parent, name)
end

