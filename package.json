local function clearGenerated()
    local workspaceFolder = workspace:FindFirstChild("GeneratedMap")

    if workspaceFolder then
        workspaceFolder:Destroy()
    end

    local replicated = game:GetService("ReplicatedStorage")
    local aiFolder = replicated:FindFirstChild("RobloxAI")

    if aiFolder then
        aiFolder:Destroy()
    end

    local server = game:GetService("ServerScriptService")
    local serverAI = server:FindFirstChild("RobloxAI")

    if serverAI then
        serverAI:Destroy()
    end

    setStatus(
        "🗑️ Projeto gerado removido.",
        Color3.fromRGB(255, 180, 80)
    )
end

--------------------------------------------------
-- CREATE REMOTES
--------------------------------------------------

local function createRemotes(parent, project)
    local remotes = getOrCreateFolder(parent, "Remotes")

    local names = {
        "Combat",
        "Attack",
        "Coins",
        "Inventory",
        "AddItem",
        "RemoveItem",
        "Pets",
        "EquipPet",
        "Quests",
        "QuestUpdate",
        "Shop",
        "BuyItem",
        "NPC",
        "SystemMessage",
        "ClaimQuest",
        "SpawnShelter",
        "AttackMonster"
    }

    if project and project.remotes then
        for _, remote in ipairs(project.remotes) do
            local remoteName

            if typeof(remote) == "string" then
                remoteName = remote
            elseif typeof(remote) == "table" then
                remoteName =
                    remote.name
                    or remote.nome
                    or remote.Name
            end

            if remoteName then
                table.insert(names, remoteName)
            end
        end
    end

    local created = {}

    for _, name in ipairs(names) do
        if not created[name] then
            created[name] = true

            if not remotes:FindFirstChild(name) then
                local remoteEvent = Instance.new("RemoteEvent")
                remoteEvent.Name = safeName(name, "RemoteEvent")
                remoteEvent.Parent = remotes
            end
        end
    end

    return remotes
end

--------------------------------------------------
-- CREATE AREAS
--------------------------------------------------

local function createAreas(parent, project)
    local areasFolder = getOrCreateFolder(parent, "Areas")

    local areas = project.areas or project.areasData or {}

    local defaultPositions = {
        Vector3.new(0, 0, 0),
        Vector3.new(150, 0, 0),
        Vector3.new(-150, 0, 0),
        Vector3.new(0, 0, 150),
        Vector3.new(0, 0, -150)
    }

    for index, area in ipairs(areas) do
        local name
        local position
        local size

        if typeof(area) == "string" then
            name = area
        else
            name = area.name or area.nome or ("Area_" .. index)

            local x = tonumber(area.x or area.posX or 0) or 0
            local y = tonumber(area.y or area.posY or 0) or 0
            local z = tonumber(area.z or area.posZ or 0) or 0

            position = Vector3.new(x, y, z)

            local sx = tonumber(area.sizeX or area.width or 80) or 80
            local sy = tonumber(area.sizeY or area.height or 10) or 10
            local sz = tonumber(area.sizeZ or area.depth or 80) or 80

            size = Vector3.new(sx, sy, sz)
        end

        position = position or defaultPositions[index] or Vector3.new(0, 0, 0)
        size = size or Vector3.new(80, 10, 80)

        local areaPart = createPart(
            areasFolder,
            name,
            position + Vector3.new(0, -5, 0),
            size
        )

        areaPart.Material = Enum.Material.Grass

        areaPart:SetAttribute("GeneratedBy", "RobloxAIBuilder")
        areaPart:SetAttribute("AreaIndex", index)

        if typeof(area) == "table" then
            areaPart:SetAttribute(
                "Description",
                tostring(area.description or area.descricao or "")
            )
        end
    end

    return areasFolder
end

--------------------------------------------------
-- CREATE OBJECTS
--------------------------------------------------

local function createObjects(parent, project)
    local objectsFolder = getOrCreateFolder(parent, "Objects")

    local objects = project.objects or project.objetos or {}

    for index, object in ipairs(objects) do
        local name
        local position
        local size

        if typeof(object) == "string" then
            name = object
        else
            name =
                object.name
                or object.nome
                or object.title
                or ("Object_" .. index)

            local x = tonumber(object.x or object.posX or 0) or 0
            local y = tonumber(object.y or object.posY or 3) or 3
            local z = tonumber(object.z or object.posZ or 0) or 0

            position = Vector3.new(x, y, z)

            local sx = tonumber(object.sizeX or 8) or 8
            local sy = tonumber(object.sizeY or 6) or 6
            local sz = tonumber(object.sizeZ or 8) or 8

            size = Vector3.new(sx, sy, sz)
        end

        position = position or Vector3.new(index * 12, 3, 0)
        size = size or Vector3.new(8, 6, 8)

        local part = createPart(
            objectsFolder,
            name,
            position,
            size
        )

        part:SetAttribute("GeneratedBy", "RobloxAIBuilder")

        if typeof(object) == "table" then
            part:SetAttribute(
                "Type",
                tostring(object.type or object.tipo or "Object")
            )

            part:SetAttribute(
                "Description",
                tostring(object.description or object.descricao or "")
            )
        end
    end

    return objectsFolder
end

--------------------------------------------------
-- CREATE NPC
--------------------------------------------------

local function createNPC(parent, npcData, index)
    local model = Instance.new("Model")

    local npcName = "NPC_" .. index

    local hp = 100

    if typeof(npcData) == "string" then
        npcName = npcData
    elseif typeof(npcData) == "table" then
        npcName =
            npcData.name
            or npcData.nome
            or npcData.title
            or npcName

        hp =
            tonumber(
                npcData.hp
                or npcData.health
                or npcData.vida
                or 100
            )
            or 100
    end

    model.Name = safeName(npcName, npcName)

    local root = Instance.new("Part")
    root.Name = "HumanoidRootPart"
    root.Size = Vector3.new(2, 2, 1)
    root.Transparency = 1
    root.CanCollide = false
    root.Anchored = false
    root.Position = Vector3.new(index * 8, 5, 0)
    root.Parent = model

    local body = Instance.new("Part")
    body.Name = "Body"
    body.Size = Vector3.new(4, 5, 2)
    body.Position = root.Position + Vector3.new(0, 2, 0)
    body.Anchored = false
    body.Parent = model

    local head = Instance.new("Part")
    head.Name = "Head"
    head.Shape = Enum.PartType.Ball
    head.Size = Vector3.new(2, 2, 2)
    head.Position = root.Position + Vector3.new(0, 5.5, 0)
    head.Anchored = false
    head.Parent = model

    local humanoid = Instance.new("Humanoid")
    humanoid.Name = "Humanoid"
    humanoid.MaxHealth = hp
    humanoid.Health = hp
    humanoid.Parent = model

    local weld1 = Instance.new("WeldConstraint")
    weld1.Part0 = root
    weld1.Part1 = body
    weld1.Parent = root

    local weld2 = Instance.new("WeldConstraint")
    weld2.Part0 = root
    weld2.Part1 = head
    weld2.Parent = root

    model.PrimaryPart = root

    model:SetAttribute("GeneratedBy", "RobloxAIBuilder")
    model:SetAttribute("MaxHealth", hp)

    if typeof(npcData) == "table" then
        model:SetAttribute(
            "Type",
            tostring(npcData.type or npcData.tipo or "NPC")
        )

        model:SetAttribute(
            "Description",
            tostring(npcData.description or npcData.descricao or "")
        )
    end

    model.Parent = parent

    return model
end

--------------------------------------------------
-- CREATE NPCS
--------------------------------------------------

local function createNPCs(parent, project)
    local npcsFolder = getOrCreateFolder(parent, "NPCs")

    local npcs =
        project.npcs
        or project.NPCs
        or project.npcsData
        or {}

    for index, npc in ipairs(npcs) do
        createNPC(
            npcsFolder,
            npc,
            index
        )
    end

    return npcsFolder
end

