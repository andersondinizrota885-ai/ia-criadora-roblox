local INVENTORY_MODULE = [[
local InventoryService = {}

local inventories = {}

function InventoryService.Get(player)
    inventories[player] = inventories[player] or {}
    return inventories[player]
end

function InventoryService.Add(player, itemName, amount)
    amount = amount or 1

    local inventory = InventoryService.Get(player)

    inventory[itemName] = (inventory[itemName] or 0) + amount

    return true
end

function InventoryService.Remove(player, itemName, amount)
    amount = amount or 1

    local inventory = InventoryService.Get(player)

    if not inventory[itemName] then
        return false
    end

    if inventory[itemName] < amount then
        return false
    end

    inventory[itemName] -= amount

    return true
end

return InventoryService
]]

local PET_MODULE = [[
local PetService = {}

local equippedPets = {}

function PetService.Equip(player, petName)
    equippedPets[player] = petName

    print(
        "[Roblox AI] Pet equipado:",
        player.Name,
        petName
    )
end

function PetService.GetEquipped(player)
    return equippedPets[player]
end

return PetService
]]

local QUEST_MODULE = [[
local QuestService = {}

local quests = {}

function QuestService.Start(player, questName)
    quests[player] = quests[player] or {}

    quests[player][questName] = {
        progress = 0,
        completed = false
    }

    return true
end

function QuestService.Progress(player, questName, amount)
    amount = amount or 1

    if not quests[player] then
        return false
    end

    if not quests[player][questName] then
        return false
    end

    quests[player][questName].progress += amount

    return true
end

function QuestService.Get(player)
    return quests[player] or {}
end

return QuestService
]]

local COINS_SCRIPT = [[
local Players = game:GetService("Players")

local function setupPlayer(player)

    local leaderstats = Instance.new("Folder")
    leaderstats.Name = "leaderstats"
    leaderstats.Parent = player

    local coins = Instance.new("IntValue")
    coins.Name = "Coins"
    coins.Value = 0
    coins.Parent = leaderstats
end

Players.PlayerAdded:Connect(setupPlayer)

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end
]]

local COMBAT_SCRIPT = [[
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ai = ReplicatedStorage:WaitForChild("RobloxAI")
local remotes = ai:WaitForChild("Remotes")

local attackRemote =
    remotes:FindFirstChild("AttackMonster")
    or remotes:FindFirstChild("Attack")

if not attackRemote then
    warn("[Roblox AI] Remote de ataque não encontrado.")
    return
end

attackRemote.OnServerEvent:Connect(function(player, target)

    if typeof(target) ~= "Instance" then
        return
    end

    if not target:IsDescendantOf(workspace) then
        return
    end

    local humanoid =
        target:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local root =
        character:FindFirstChild("HumanoidRootPart")

    local targetRoot =
        target:FindFirstChild("HumanoidRootPart")

    if not root or not targetRoot then
        return
    end

    local distance =
        (root.Position - targetRoot.Position).Magnitude

    if distance > 15 then
        return
    end

    humanoid:TakeDamage(20)
end)
]]

local NPC_SCRIPT = [[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local map = workspace:FindFirstChild("GeneratedMap")

if not map then
    return
end

local npcs = map:FindFirstChild("NPCs")

if not npcs then
    return
end

local function getNearestPlayer(position)

    local nearest
    local shortest = math.huge

    for _, player in ipairs(Players:GetPlayers()) do

        local character = player.Character

        if character then

            local root =
                character:FindFirstChild("HumanoidRootPart")

            if root then

                local distance =
                    (root.Position - position).Magnitude

                if distance < shortest then
                    shortest = distance
                    nearest = player
                end
            end
        end
    end

    return nearest
end

RunService.Heartbeat:Connect(function()

    for _, npc in ipairs(npcs:GetChildren()) do

        local humanoid =
            npc:FindFirstChildOfClass("Humanoid")

        local root =
            npc:FindFirstChild("HumanoidRootPart")

        if humanoid and root and humanoid.Health > 0 then

            local player =
                getNearestPlayer(root.Position)

            if player and player.Character then

                local targetRoot =
                    player.Character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if targetRoot then

                    local distance =
                        (targetRoot.Position - root.Position).Magnitude

                    if distance > 8 and distance < 100 then

                        humanoid:MoveTo(
                            targetRoot.Position
                        )
                    end
                end
            end
        end
    end
end)
]]

local SHOP_SCRIPT = [[
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ai = ReplicatedStorage:WaitForChild("RobloxAI")
local remotes = ai:WaitForChild("Remotes")

local buyRemote =
    remotes:FindFirstChild("BuyItem")

if not buyRemote then
    return
end

local prices = {
    ["Espada Enferrada"] = 100,
    ["Clamor de Aco"] = 500,
    ["Pocao de Cura"] = 75
}

buyRemote.OnServerEvent:Connect(function(player, itemName)

    if typeof(itemName) ~= "string" then
        return
    end

    local price = prices[itemName]

    if not price then
        return
    end

    local stats = player:FindFirstChild("leaderstats")

    if not stats then
        return
    end

    local coins = stats:FindFirstChild("Coins")

    if not coins then
        return
    end

    if coins.Value < price then
        return
    end

    coins.Value -= price

    print(
        "[Roblox AI] Compra:",
        player.Name,
        itemName
    )
end)
]]

