local function createModule(parent, name, source)
    local module = Instance.new("ModuleScript")

    module.Name = safeName(name, "Module")

    module.Source = source or [[
local Module = {}

function Module.Init()
    print("[Roblox AI] Module iniciado:", script.Name)
end

return Module
]]

    module.Parent = parent

    return module
end

--------------------------------------------------
-- CREATE SERVER SCRIPT
--------------------------------------------------

local function createServerScript(parent, name, source)
    local scriptObject = Instance.new("Script")

    scriptObject.Name = safeName(name, "ServerScript")

    scriptObject.Source = source or [[
print("[Roblox AI] ServerScript iniciado:", script.Name)
]]

    scriptObject.Parent = parent

    return scriptObject
end

