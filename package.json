--------------------------------------------------
-- CREATE GENERATED SCRIPTS
--------------------------------------------------

local function createGeneratedScripts(serverAI, project)
    local scriptsFolder = getOrCreateFolder(
        serverAI,
        "Scripts"
    )

    local scripts =
        project.scripts
        or project.all_scripts
        or {}

    for index, data in ipairs(scripts) do

        local name
        local source
        local scriptType

        if typeof(data) == "string" then

            name = "GeneratedScript_" .. index
            source = data
            scriptType = "Script"

        else

            name =
                data.name
                or data.nome
                or data.title
                or ("GeneratedScript_" .. index)

            source =
                data.source
                or data.code
                or data.codigo
                or ""

            scriptType =
                data.type
                or data.scriptType
                or "Script"
        end

        if scriptType == "LocalScript" then

            createLocalScript(
                scriptsFolder,
                name,
                source
            )

        elseif scriptType == "ModuleScript" then

            createModule(
                scriptsFolder,
                name,
                source
            )

        else

            createServerScript(
                scriptsFolder,
                name,
                source
            )
        end
    end

    return scriptsFolder
end

--------------------------------------------------
-- LIGHTING
